{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/VANYAPROD/index.html" },
    { "source": "/productmanager", "destination": "/VANYAPROD/productmanager.html" },
    { "source": "/vendormanager", "destination": "/VANYAPROD/vendormanager.html" },
    { "source": "/assets/(.*)", "destination": "/VANYAPROD/assets/$1" },
    { "source": "/((?!api/).*)", "destination": "/VANYAPROD/$1" }
  ]
}
